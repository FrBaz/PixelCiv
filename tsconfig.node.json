{
  // Code exécuté sous Node : configuration de Vite et outils de tools/, tests compris. Les
  // tests de tools/ lisent aussi le rendu des humains, qui importe l'atlas du build.
  // Le chargeur natif de Vite, appelé à devenir la règle, exige l'extension .ts dans
  // les imports de la configuration et des modules qu'elle charge.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["vite.config.ts", "tools", "src/render/human-atlas.d.ts"]
}
